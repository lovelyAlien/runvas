# docker-compose.yml에서 사용하는 값입니다. 실제 값은 .env에 넣고 커밋하지 않습니다.
POSTGRES_PASSWORD=runvas
POSTGRES_PORT=5432
REDIS_PORT=6379

# backend 서비스는 `docker compose --profile deploy up -d`로 배포할 때만 사용합니다.
# 로컬 개발(./gradlew bootRun)에는 영향 없습니다.
JWT_SECRET=dev-secret-dev-secret-dev-secret-dev-secret
JWT_EXPIRATION_SECONDS=3600
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
TMAP_APP_KEY=
UPLOAD_BASE_URL=http://localhost:8921

# 최초 1회, admin_accounts 테이블이 비어 있을 때만 운영자 계정을 자동 생성합니다.
# docs/admin-dashboard.md 참고. 배포 후에는 비워두거나 삭제해도 무방합니다(이미 계정이 있으면 무시됨).
ADMIN_SEED_USERNAME=
ADMIN_SEED_PASSWORD=

# 신고/차단 발생 시 운영자에게 이메일로 알리는 기능에 사용합니다.
# 비워두면 이메일 발송이 조용히 비활성화됩니다(에러 없이 알림만 안 감).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=
